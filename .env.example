# Copy to .env and fill in.

# ── DeepSeek backend ──────────────────────────────────────────────────────
# Used for password login when a persistent profile is not yet seeded.
# (Credentials can also live in cookies/auth.json — see config/deepseek.py.)
DEEPSEEK_EMAIL=your-email@example.com
DEEPSEEK_PASSWORD=your-deepseek-password

# ── Qwen backend ──────────────────────────────────────────────────────────
# Qwen uses cookie files in cookies/ (account1.json, account2.json, ...).
# No email/password needed.

# ── ChatGPT backend ─────────────────────────────────────────────────────────
# Login otomatis email+password dari cookies/authchatgpt.json
# (format sama dengan auth.json). Env fallback di bawah.
CHATGPT_EMAIL=you@yourmail.com
CHATGPT_PASSWORD=your-chatgpt-password
# Optional: set to "chrome" to launch real installed Google Chrome instead of
# the bundled Playwright Chromium (requires `playwright install chrome` or a
# system Chrome install on this machine). Use this if login gets stuck on a
# Cloudflare Turnstile "Performing security verification" challenge on
# auth.openai.com even with the stealth script applied.
# CHATGPT_BROWSER_CHANNEL=chrome
# Which Playwright-compatible driver drives the ChatGPT browser:
#   auto       (default) patchright if installed, else vanilla playwright
#   patchright patched Playwright — removes CDP automation leaks that
#              Cloudflare Turnstile detects (RECOMMENDED; install with
#              `pip install patchright` + `python -m patchright install chromium`)
#   playwright vanilla Playwright (old behavior)
# CHATGPT_BROWSER_DRIVER=auto
# STRONGEST Cloudflare workaround: attach to an ALREADY-RUNNING real Chrome
# over CDP instead of launching one. Start that Chrome first with:
#   python start_chatgpt_chrome.py --account account1
# then set CHATGPT_CDP_ATTACH=1 before running the worker / login helper.
# CHATGPT_CDP_ATTACH=1
# CDP endpoint to attach to (default http://127.0.0.1:9222).
# CHATGPT_CDP_URL=http://127.0.0.1:9222

# ── VPS gateway (PublicForward/ForVPS/vps_server.py) ──────────────────────
# Shared auth token between the VPS and every worker. Leave as the default
# "change-me" to disable token enforcement (dev only). When set to any other
# value, workers must pass a matching --token.
PAF_TOKEN=change-me
# Per-request timeout (seconds) the VPS waits for a worker result.
PAF_REQUEST_TIMEOUT=330
# How long the VPS waits for a free worker before returning 504 (seconds).
WORKER_WAIT_TIMEOUT=60
